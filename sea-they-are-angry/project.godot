; Engine configuration file.
config_version=5

[application]

config/name="Sea They Are Angry"
run/main_scene="res://scenes/main.tscn"
boot_splash/bg_color=Color(0.02, 0.02, 0.03, 1)
boot_splash/show_image=false
config/features=PackedStringArray("4.3", "Forward Plus")

[autoload]

StudioSplash="*res://studio/splash.gd"
Events="*res://autoload/events.gd"
Run="*res://autoload/run.gd"
Cycle="*res://autoload/cycle.gd"
Stock="*res://autoload/stock.gd"
Anger="*res://autoload/anger.gd"
SaveSys="*res://autoload/save_sys.gd"
InputSetup="*res://autoload/input_setup.gd"
Audio="*res://autoload/audio.gd"
Players="*res://autoload/players.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[gui]

theme/custom_font="res://fonts/SpecialElite.ttf"

[rendering]

renderer/rendering_method="forward_plus"

[shader_globals]

storm={
"type": "float",
"value": 0.0
}
